config NCS_BM
	bool "NCS Bare Metal"
	default y

if NCS_BM

# NCS Bare Metal option is designed to run without multithreading. Tests are exempted.
configdefault MULTITHREADING
	default y if (UNITY || (ZTEST && BOARD_NATIVE_SIM))
	default n

# NCS Bare metal option is designed to use direct ISRs only. Disable the additional SW ISR table.
configdefault GEN_SW_ISR_TABLE
	default n

# zephyr-keep-sorted-start
rsource "drivers/Kconfig"
rsource "lib/Kconfig"
rsource "modules/Kconfig"
rsource "subsys/Kconfig"
# zephyr-keep-sorted-stop

endif # NCS_BM
