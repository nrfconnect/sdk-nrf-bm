/*
 * This overlay file adds additional devicetree definitions for the
 * bm_nrf54l15dk_nrf54l10_cpuapp_s115_softdevice target.
 * It deletes the app_ram and place it later in memory to create space for the flpr memory
 */

/delete-node/ &app_ram;

&cpuapp_sram {
	flpr_firmware_ram: sram@4380 {
		label = "flpr_firmware_ram";
		reg = <0x4380 0x3740>;
	};

	flpr_execution_ram: sram@7ac0 {
		label = "flpr_execution_ram";
		reg = <0x7ac0 0x400>;
	};

	flpr_vri_ram: sram@7ec0 {
		label = "flpr_vri_ram";
		reg = <0x7ec0 0x200>;
	};

	app_ram: sram@80c0 {
		label = "app_ram";
		reg = <0x80c0 (DT_SIZE_K(223) + 0x140)>;
	};
};
