/* The sample keeps the first 128 kB, and the rest up to the storage partition is the
 * slot it writes uploads into. S115 12.0.0-1.prototype sits at 0x1e5800.
 */

/delete-node/ &softdevice_partition;

&slot0_partition {
	reg = <0x00000000 DT_SIZE_K(128)>;
};

&cpuapp_rram {
	partitions {
		update_partition: partition@20000 {
			compatible = "zephyr,mapped-partition";
			label = "update";
			reg = <0x00020000 0x1c1800>;
		};

		softdevice_partition: partition@1e5800 {
			compatible = "zephyr,mapped-partition";
			label = "softdevice";
			reg = <0x001e5800 0x17400>;
		};
	};
};
