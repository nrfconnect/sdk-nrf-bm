# The sample runs on S115 12.0.0-1.prototype, which it carries in softdevice/. This
# default comes before the SDK's, so it is the one that applies.
config SOFTDEVICE_FILE
	string
	default "$(APP_DIR)/softdevice/s115_nrf54lm20_12.0.0-1.prototype_softdevice.hex" if SOFTDEVICE_S115 && SOC_NRF54LM20A

source "share/sysbuild/Kconfig"
