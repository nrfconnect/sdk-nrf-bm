# This file partially overrides the nrfx Kconfigs in zephyr/modules/hal_nordic/nrfx/Konfig to allow
# all options to be set without having the peripherals defined in Device Tree.

menu "nrfx drivers"
	depends on HAS_NRFX

config NRFX_CLOCK
	bool "CLOCK driver"

config NRFX_COMP
	bool "COMP driver"

config NRFX_EGU0
	bool "EGU0 driver instance"
	select NRFX_EGU

config NRFX_EGU1
	bool "EGU1 driver instance"
	select NRFX_EGU

config NRFX_EGU2
	bool "EGU2 driver instance"
	select NRFX_EGU

config NRFX_EGU3
	bool "EGU3 driver instance"
	select NRFX_EGU

config NRFX_EGU4
	bool "EGU4 driver instance"
	select NRFX_EGU

config NRFX_EGU5
	bool "EGU5 driver instance"
	select NRFX_EGU

config NRFX_EGU10
	bool "EGU10 driver instance"
	select NRFX_EGU

config NRFX_EGU20
	bool "EGU20 driver instance"
	select NRFX_EGU

config NRFX_EGU020
	bool "EGU020 driver instance"
	select NRFX_EGU

config NRFX_EGU130
	bool "EGU130 driver instance"
	select NRFX_EGU

config NRFX_GRTC
	bool "GRTC driver"

config NRFX_IPC
	bool "IPC driver"

config NRFX_LPCOMP
	bool "LPCOMP driver"
	depends on !SOC_NRF52810 && !SOC_NRF52811 && !SOC_NRF52820

config NRFX_MRAMC
	bool "MRAMC driver"

config NRFX_NFCT
	bool "NFCT driver"
	select NRFX_TIMER

config NRFX_NVMC
	bool "NVMC driver"

config NRFX_POWER
	bool "POWER driver"

config NRFX_QSPI
	bool "QSPI driver"

config NRFX_RNG
	bool "RNG driver"

config NRFX_RRAMC
	bool "RRAMC driver"

config NRFX_SAADC
	bool "SAADC driver"
	depends on !SOC_SERIES_NRF51

config NRFX_SPIM
	bool "SPIM driver"

config NRFX_SPIS
	bool "SPIS driver"

config NRFX_TBM
	bool "TBM driver"

config NRFX_TEMP
	bool "TEMP driver"

config NRFX_USBREG
	bool "USBREG driver"

config NRFX_WDT
	bool "WDT driver"

endmenu # "nrfx drivers"
